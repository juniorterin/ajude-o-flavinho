# Estas variaveis devem ser configuradas em Vercel > Settings > Environment
# Variables do seu projeto (nao sao lidas de um arquivo .env em producao).
# Para rodar localmente com `vercel dev`, copie este arquivo para .env.local
# e preencha os valores, ou rode `vercel env pull .env.local` depois de
# configura-las no dashboard.

# Dashboard Stripe > Developers > API keys
# Comece com as chaves de TESTE (sk_test_/pk_test_) ate confirmar que tudo
# funciona, so depois troque para as chaves live (sk_live_/pk_live_).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# OBRIGATORIO: e este webhook que grava cada doacao confirmada no banco de
# dados (total arrecadado + lista de doacoes). Sem ele, a barra de progresso
# nunca sai do valor inicial gravado por scripts/seed-total.js.
# (Dashboard Stripe > Developers > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Banco de dados (Redis via Upstash) onde o total arrecadado e a lista de
# doacoes ficam guardados - e a UNICA fonte de verdade do valor arrecadado.
# Se voce conectar um banco "Upstash for Redis" pela aba Storage do seu
# projeto no Vercel, essas variaveis sao criadas automaticamente (nomes
# podem vir como KV_REST_API_URL/KV_REST_API_TOKEN, o codigo aceita os
# dois formatos).
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxxxxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: URL publica do site (ex: https://ajude-o-flavinho.vercel.app).
# Se nao for definida, o codigo usa automaticamente o dominio da propria
# requisicao.
DOMAIN=

# Meta da campanha, em CENTAVOS.
GOAL_CENTS=1500000
